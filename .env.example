# Copy this file to .env.local and fill in the values from
# Supabase → Settings → API on the Rade.XT project.
# The anon key is safe to expose to the browser (that's what it's for) -
# access is controlled by Row Level Security, not by hiding this key.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Drive picker — from Google Cloud Console.
# Both are safe in the browser: the client ID is public by design, and the
# API key is restricted to your authorised origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=

# --- Server-only secrets (set these in Render -> Environment, never NEXT_PUBLIC_) ---
# Already used by Studyboy and the command bar:
# ANTHROPIC_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Kindle e-ink display links:
# EINK_ACCESS_TOKEN=
# Kindle "Ask JARVIS" typed commands (POST /api/kindle/command). Make it long and
# random, e.g. `openssl rand -hex 24`, and paste the same value into the plugin.
# Kept separate from EINK_ACCESS_TOKEN because this one can add tasks and spend API credit.
# KINDLE_COMMAND_TOKEN=
